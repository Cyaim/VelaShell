<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- 证书 + 私钥的样本借 SSH 库测试的那一份（真 ssh-keygen 生成与签发，见那边 Keys/Fixtures/README.md）。 -->
    <None Include="..\VelaShell.Ssh.Tests\Keys\Fixtures\cert-ed25519;..\VelaShell.Ssh.Tests\Keys\Fixtures\cert-ed25519-cert.pub"
          Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用真实 wire/KEX/认证服务端，宿主回归仍走 assembler → wrapper → service。 -->
    <Compile Include="..\VelaShell.Ssh.Tests\TestKit\TestSshServer.cs" Link="Ssh\TestKit\TestSshServer.cs" />
    <Compile Include="..\VelaShell.Ssh.Tests\TestKit\TestHostKey.cs" Link="Ssh\TestKit\TestHostKey.cs" />
    <Compile Include="..\VelaShell.Ssh.Tests\TestKit\TestKexResponder.cs" Link="Ssh\TestKit\TestKexResponder.cs" />
    <Compile Include="..\VelaShell.Ssh.Tests\TestKit\TestAuthServer.cs" Link="Ssh\TestKit\TestAuthServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VelaShell.Core\VelaShell.Core.csproj" />
    <ProjectReference Include="..\..\src\VelaShell.Infrastructure\VelaShell.Infrastructure.csproj" />
  </ItemGroup>

</Project>
