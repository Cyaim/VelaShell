<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:loc="using:VelaShell.Localization"
        xmlns:pc="using:VelaShell.Controls.Controls"
        x:Class="VelaShell.Views.AuditLogView"
        x:DataType="vm:AuditLogViewModel"
        Title="{loc:Localize AuditLog_Title}"
        Width="1040" Height="640"
        MinWidth="880" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

  <!-- 审计日志(设置 → 安全审计 → 查看审计日志):标题栏、筛选条、表头 + 按时间倒序的列表。
       外框、标题栏与右下角缩放手柄照录制回放中心(RecordingPlayerView)的做法。 -->

  <Window.Styles>
    <!-- 窗口控制键:27×27、无圆角,规格同主窗口(与回放中心、资源监视同一套本地样式)。 -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaDangerHover}" />
    </Style>
    <!-- 筛选条上的下拉与关键字框:28 高,与任务管理器、路由追踪的工具条输入框、以及同一排的描边按钮
         (VelaOutlineButtonTheme,DESIGN.md §5.1)一致。不写的话吃的是 Fluent 默认的最小高 32 与 14 号字,
         比别的工具窗口的筛选框高一截。下拉用 12 号字:11 号的比例字体在亮色主题下发糊(同设置页那处说明)。 -->
    <Style Selector="Border.filter-bar ComboBox">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.filter-bar TextBox">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.audit-list">
      <!-- 右侧留出 16 以上:滚动条是覆盖式的,展开时不该压住详情一栏的末尾。 -->
      <Setter Property="Padding" Value="0,0,16,0" />
    </Style>
    <Style Selector="ListBox.audit-list ListBoxItem">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.audit-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ListBox.audit-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="ListBox.audit-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cell.mono">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    </Style>
    <!-- 异常事件(连接失败、拒绝 / 接受了变更的指纹)的事件名标红,一眼扫得出来。 -->
    <Style Selector="TextBlock.cell.problem">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- 行尾「打开配置」:22×22 透明图标键,悬停换底色;配置已删时半透明。 -->
    <Style Selector="Button.open-profile">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.open-profile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.open-profile:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.open-profile:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.filter-bar CalendarDatePicker">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*">

      <!-- 标题栏(28,可拖动,双击空白处最大化 / 还原)。窗口键 27×27 贴住右上角,与主窗口同规格。 -->
      <Border Grid.Row="0" Padding="20,0,0,0"
              Classes="window-titlebar"
              Background="Transparent"
              PointerPressed="Header_PointerPressed"
              DoubleTapped="Header_DoubleTapped">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <DockPanel>
            <Panel Classes="traffic-light-spacer" DockPanel.Dock="Left" />
            <TextBlock Text="{loc:Localize AuditLog_Title}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource VelaTextPrimary}"
                       FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <!-- 窗口级动作收进标题栏的动作图标组(DESIGN.md §4.2):导出眼前筛出来的这些为 CSV。 -->
          <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="ExportCsvButton"
                    Theme="{StaticResource VelaTitleActionButtonTheme}"
                    IsEnabled="{Binding !IsEmpty}"
                    Click="ExportCsv_Click"
                    AutomationProperties.Name="{loc:Localize AuditLog_ExportCsv}">
              <ToolTip.Tip>
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Localize AuditLog_ExportCsv}" FontWeight="Medium" />
                  <TextBlock Text="{loc:Localize AuditLog_ExportCsvTip}" />
                </StackPanel>
              </ToolTip.Tip>
              <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.download}"
                             Foreground="{DynamicResource VelaTextMuted}" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Classes="caption window-caption" Click="Maximize_Click"
                    ToolTip.Tip="{loc:Localize Recorder_MaximizeTip}">
              <pc:LucideIcon Width="10" Height="10" Data="{StaticResource Icon.square}"
                             Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Classes="caption caption-close window-caption" Click="Close_Click">
              <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.x}"
                             Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 筛选条:类别 / 只看异常 / 关键字 / 刷新,右边一行摘要。 -->
      <Border Grid.Row="1" Padding="20,8" Classes="filter-bar"
              Background="Transparent"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,8,Auto,Auto,12,Auto,12,*,12,Auto">
          <ComboBox Grid.Column="0" Width="120" VerticalAlignment="Center"
                    ItemsSource="{Binding CategoryOptions}"
                    SelectedIndex="{Binding CategoryIndex}"
                    AutomationProperties.Name="{loc:Localize AuditLog_ColCategory}" />
          <!-- 时间段:换了就重新读库(只在已载入的最近 2000 条里筛,早一点的那一段会是空的)。 -->
          <ComboBox x:Name="RangeSelector" Grid.Column="2" Width="120" VerticalAlignment="Center"
                    ItemsSource="{Binding RangeOptions}"
                    SelectedIndex="{Binding RangeIndex}"
                    AutomationProperties.Name="{loc:Localize AuditLog_Range}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsCustomRange}">
            <CalendarDatePicker x:Name="RangeFromPicker" Width="124"
                                SelectedDate="{Binding CustomFrom}"
                                PlaceholderText="{loc:Localize AuditLog_RangeFrom}"
                                AutomationProperties.Name="{loc:Localize AuditLog_RangeFrom}" />
            <TextBlock Text="–" VerticalAlignment="Center" Foreground="{DynamicResource VelaTextMuted}" />
            <CalendarDatePicker x:Name="RangeToPicker" Width="124"
                                SelectedDate="{Binding CustomTo}"
                                PlaceholderText="{loc:Localize AuditLog_RangeTo}"
                                AutomationProperties.Name="{loc:Localize AuditLog_RangeTo}" />
          </StackPanel>
          <CheckBox Grid.Column="5" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center"
                    Padding="0" MinHeight="0">
            <TextBlock Text="{loc:Localize AuditLog_OnlyProblems}" Margin="6,0,0,0"
                       Foreground="{DynamicResource VelaTextSecondary}"
                       FontSize="{DynamicResource VelaFontSize11}" />
          </CheckBox>
          <TextBox Grid.Column="7"
                   Text="{Binding SearchText}"
                   PlaceholderText="{loc:Localize AuditLog_SearchPlaceholder}" />
          <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                       Foreground="{DynamicResource VelaTextMuted}"
                       FontSize="{DynamicResource VelaFontSize10}" />
            <Button Theme="{StaticResource VelaOutlineButtonTheme}"
                    Content="{loc:Localize Refresh}" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 表头 + 列表。列宽固定,详情一栏吃掉余下的宽度。 -->
      <Border Grid.Row="2" Margin="20,12,20,16" CornerRadius="6"
              Background="{DynamicResource VelaBgInput}"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1">
        <Grid RowDefinitions="30,*">
          <Border Grid.Row="0" Padding="12,0,28,0"
                  BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="148,72,172,160,*,28">
              <TextBlock Grid.Column="0" Classes="header" Text="{loc:Localize AuditLog_ColTime}" />
              <TextBlock Grid.Column="1" Classes="header" Text="{loc:Localize AuditLog_ColCategory}" />
              <TextBlock Grid.Column="2" Classes="header" Text="{loc:Localize AuditLog_ColAction}" />
              <TextBlock Grid.Column="3" Classes="header" Text="{loc:Localize AuditLog_ColSession}" />
              <TextBlock Grid.Column="4" Classes="header" Text="{loc:Localize AuditLog_ColDetail}" />
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" Margin="12" TextWrapping="Wrap"
                     FontSize="{DynamicResource VelaFontSize11}"
                     Foreground="{DynamicResource VelaTextMuted}"
                     Text="{loc:Localize AuditLog_Empty}"
                     IsVisible="{Binding IsEmpty}" />
          <ListBox Grid.Row="1" Classes="audit-list" Background="Transparent"
                   ItemsSource="{Binding Rows}"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AuditLogRow">
                <Grid ColumnDefinitions="148,72,172,160,*,28">
                  <TextBlock Grid.Column="0" Classes="cell mono" Text="{Binding TimeText}" />
                  <TextBlock Grid.Column="1" Classes="cell" Text="{Binding CategoryLabel}" />
                  <TextBlock Grid.Column="2" Classes="cell" Classes.problem="{Binding IsProblem}"
                             Text="{Binding ActionLabel}" ToolTip.Tip="{Binding Action}" />
                  <TextBlock Grid.Column="3" Classes="cell" Text="{Binding SessionName}"
                             ToolTip.Tip="{Binding SessionName}" />
                  <TextBlock Grid.Column="4" Classes="cell mono" Text="{Binding Detail}"
                             ToolTip.Tip="{Binding Detail}" />
                  <!-- 打开这一行的连接配置:记录里带着配置 Id 才有;配置已删就灰着(提示写在悬停里)。 -->
                  <Button Grid.Column="5" Classes="open-profile"
                          IsVisible="{Binding HasProfile}"
                          IsEnabled="{Binding ProfileExists}"
                          Click="OpenProfile_Click"
                          ToolTip.Tip="{Binding OpenProfileTip}"
                          ToolTip.ShowOnDisabled="True"
                          AutomationProperties.Name="{Binding OpenProfileTip}">
                    <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.external-link}"
                                   Foreground="{DynamicResource VelaTextTertiary}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 右下角缩放手柄(同录制回放中心;系统自带边缘缩放时与最大化时由 WindowChrome 隐去)。 -->
      <Border x:Name="ResizeGrip" Grid.Row="2" Width="20" Height="20" ZIndex="10"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner"
              PointerPressed="ResizeGrip_PointerPressed"
              ToolTip.Tip="{loc:Localize Recorder_ResizeTip}">
        <Path Data="M14,4 L4,14 M14,9 L9,14"
              Stroke="{DynamicResource VelaTextMuted}" StrokeThickness="1.5"
              Margin="0,0,3,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
      </Border>
    </Grid>
  </Border>
</Window>
