<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:cred="using:VelaShell.Core.Credentials"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        x:Class="VelaShell.Views.SharedPasswordPickerDialog"
        x:DataType="vm:SharedPasswordPickerViewModel"
        Title="{loc:Localize PasswordFill_Title}"
        Width="560" Height="480" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Classes="window-card" Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0">
      <Border Classes="window-titlebar" PointerPressed="Header_PointerPressed"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <pc:LucideIcon Width="15" Height="15" Margin="14,0,8,0" Data="{DynamicResource Icon.key-round}"
                         Foreground="{DynamicResource VelaAccent}" />
          <TextBlock Grid.Column="1" Text="{loc:Localize PasswordFill_Title}" VerticalAlignment="Center"
                     Foreground="{DynamicResource VelaTextPrimary}" FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold" />
          <Button Grid.Column="2" Classes="window-caption" Width="27" Height="27" Click="Cancel_Click"
                  ToolTip.Tip="{loc:Localize Cancel}" AutomationProperties.Name="{loc:Localize Cancel}">
            <pc:LucideIcon Width="12" Height="12" Data="{DynamicResource Icon.x}" />
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Spacing="6" Margin="18,14,18,10">
        <TextBlock Text="{Binding Target}" Foreground="{DynamicResource VelaTextPrimary}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localize PasswordFill_Warning}" Foreground="{DynamicResource VelaWarning}"
                   FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox Grid.Row="2" x:Name="SearchInput" Margin="18,0,18,10" Text="{Binding SearchQuery, Mode=TwoWay}"
               PlaceholderText="{loc:Localize PasswordFill_Search}" AutomationProperties.Name="{loc:Localize PasswordFill_Search}" />
      <ListBox Grid.Row="3" x:Name="CredentialList" Margin="18,0" ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutomationProperties.Name="{loc:Localize PasswordFill_Title}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="cred:SharedCredentialMetadata">
            <Grid ColumnDefinitions="*,Auto" Margin="4,5">
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource VelaTextPrimary}" />
              <TextBlock Grid.Column="1" Text="{Binding Username}" Margin="14,0,0,0" Foreground="{DynamicResource VelaTextSecondary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="18,10" TextWrapping="Wrap"
                 Foreground="{DynamicResource VelaWarning}" FontSize="{DynamicResource VelaFontSize11}" />
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="18,4,18,16">
        <Button x:Name="CancelButton" Theme="{DynamicResource VelaOutlineButtonTheme}" Content="{loc:Localize Cancel}" Click="Cancel_Click" />
        <Button x:Name="FillButton" Theme="{DynamicResource VelaAccentPillButtonTheme}" Content="{loc:Localize PasswordFill_Confirm}" Click="Fill_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
