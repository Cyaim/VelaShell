<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="480"
        x:Class="VelaShell.Views.ConnectionDiagnosticsView"
        x:DataType="vm:ConnectionDiagnosticsViewModel"
        Title="{loc:Localize Diag_Title}"
        Width="768" Height="488"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- 连接诊断中心,布局对齐设计帧 RGXg1:标题栏(标题 + 导出 / 重新检测 + 关闭)、目标行,
       左侧诊断步骤面板,右侧发现问题 + 修复建议。 -->

  <Window.Resources>
    <!-- 右侧面板的两页(诊断结果 / 协议轨迹):选中的一页 VelaAccentDim 底 + VelaAccent 字,
         与目录同步窗口的选项分段同一条半透明药丸规则(DESIGN.md §5.1)。RadioButton:两页互斥,点已选中的那页不会把它点掉。 -->
    <ControlTheme x:Key="DiagPanelTabTheme" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
        <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      </Style>
      <!-- 焦点记号只给键盘导航:鼠标点完一页后描边一直挂着,看起来像卡住的高亮。 -->
      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- 关闭键:27×27、无圆角,规格同主窗口的窗口键(与回放中心、资源监视同一套本地样式)。
         这是对话框,不挂 window-caption —— macOS 上没有红绿灯替它,× 要照常显示。 -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaDangerHover}" />
    </Style>
    <!-- 协议轨迹的行:等宽小字,发出的那一列箭头用强调色,收到的用次要色。 -->
    <Style Selector="Grid.trace-row TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    </Style>
    <Style Selector="TextBlock.trace-direction">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.trace-direction.sent">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
    <!-- 步骤行状态配色 -->
    <Style Selector="TextBlock.step-status">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <DockPanel>

      <!-- Header (design diagHeader):标题栏(28,与全部窗口一致;可拖动)= 图标 + 标题 | 导出报告、重新检测 | 关闭。
           两个动作与主窗口的全局功能图标同一个主题(VelaTitleActionButtonTheme),原先在目标行右边。 -->
      <Border DockPanel.Dock="Top" Padding="20,0,0,0"
              Classes="window-titlebar"
              Background="Transparent"
              PointerPressed="Header_PointerPressed">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <pc:LucideIcon Width="15" Height="15"
                           Data="{StaticResource Icon.stethoscope}"
                           Foreground="{DynamicResource VelaAccent}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Localize Diag_Header}"
                       Foreground="{DynamicResource VelaTextPrimary}"
                       FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center" Margin="12,0,10,0">
            <Button Theme="{StaticResource VelaTitleActionButtonTheme}"
                    Click="ExportReport_Click"
                    IsEnabled="{Binding CanExport}"
                    AutomationProperties.Name="{loc:Localize Diag_ExportReport}"
                    ToolTip.Tip="{loc:Localize Diag_ExportReport}">
              <pc:LucideIcon Width="12" Height="12"
                             Data="{StaticResource Icon.download}"
                             Foreground="{DynamicResource VelaTextMuted}" />
            </Button>
            <!-- 检测进行中命令不可用,按钮随之变淡,免得连点叠出两轮。 -->
            <Button Theme="{StaticResource VelaTitleActionButtonTheme}"
                    Command="{Binding RunCommand}"
                    AutomationProperties.Name="{loc:Localize Diag_Rerun}"
                    ToolTip.Tip="{loc:Localize Diag_Rerun}">
              <pc:LucideIcon Width="12" Height="12"
                             Data="{StaticResource Icon.refresh-cw}"
                             Foreground="{DynamicResource VelaTextMuted}" />
            </Button>
          </StackPanel>
          <!-- 关闭:27×27 方形命中区贴住右上角,与主窗口的窗口键同规格。 -->
          <Button Grid.Column="2" Classes="caption caption-close" VerticalAlignment="Top"
                  Click="Close_Click"
                  ToolTip.Tip="{loc:Localize Diag_CloseTip}">
            <pc:LucideIcon Width="12" Height="12"
                           Data="{StaticResource Icon.x}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
          </Button>
        </Grid>
      </Border>

      <!-- 目标行:只剩诊断目标。同样可拖动。 -->
      <Border DockPanel.Dock="Top" Padding="20,6"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              Background="Transparent"
              PointerPressed="Header_PointerPressed">
        <TextBlock Text="{Binding TargetSummary}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource VelaTextMuted}"
                   FontFamily="{DynamicResource VelaUiMonoFont}"
                   FontSize="{DynamicResource VelaFontSize10}" TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- Body (design diagBody): 左步骤面板 + 右问题面板 -->
      <Grid Margin="20,16" ColumnDefinitions="320,16,*">

        <!-- 诊断步骤 (design stepPanel) -->
        <Border Grid.Column="0"
                Background="{DynamicResource VelaBgPrimary}"
                BorderBrush="{DynamicResource VelaBorderPrimary}"
                BorderThickness="1" CornerRadius="6">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="34" Padding="12,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource VelaBorderPrimary}">
              <TextBlock Text="{loc:Localize Diag_Steps}"
                         Foreground="{DynamicResource VelaTextSecondary}"
                         FontSize="{DynamicResource VelaFontSize12}" FontWeight="Medium" VerticalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="12,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagnosticStepItemViewModel">
                  <StackPanel Margin="0,0,0,12" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding DisplayName}"
                                 Classes="step-status"
                                 Foreground="{DynamicResource VelaTextPrimary}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusText}"
                                 Classes="step-status"
                                 Classes.st-ok="{Binding IsSuccess}"
                                 Classes.st-warn="{Binding IsWarning}"
                                 Classes.st-fail="{Binding IsFailed}"
                                 Classes.st-muted="{Binding IsMuted}"
                                 Classes.st-running="{Binding IsRunning}">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock.st-ok">
                            <Setter Property="Foreground" Value="{DynamicResource VelaStatusConnected}" />
                          </Style>
                          <Style Selector="TextBlock.st-warn">
                            <Setter Property="Foreground" Value="{DynamicResource VelaWarning}" />
                          </Style>
                          <Style Selector="TextBlock.st-fail">
                            <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
                          </Style>
                          <Style Selector="TextBlock.st-muted">
                            <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
                          </Style>
                          <Style Selector="TextBlock.st-running">
                            <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Detail}"
                               IsVisible="{Binding HasDetail}"
                               Foreground="{DynamicResource VelaTextMuted}"
                               FontFamily="{DynamicResource VelaUiMonoFont}"
                               FontSize="{DynamicResource VelaFontSize10}" TextWrapping="Wrap"
                               Margin="14,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- 右侧面板:「诊断结果」(发现问题 + 修复建议,design issuePanel)与「协议轨迹」两页,
             头栏 34 高与左边「诊断步骤」那一栏对齐。窗口不可缩放,轨迹放进同一块面板而不是再往下加一栏。 -->
        <Border Grid.Column="2"
                Background="{DynamicResource VelaBgPrimary}"
                BorderBrush="{DynamicResource VelaBorderPrimary}"
                BorderThickness="1" CornerRadius="6">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="34" Padding="8,0,6,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource VelaBorderPrimary}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <RadioButton x:Name="ResultsTab" Grid.Column="0" GroupName="DiagPanel"
                             Theme="{StaticResource DiagPanelTabTheme}"
                             IsChecked="{Binding ShowsResults}"
                             Content="{loc:Localize Diag_TabResults}" />
                <RadioButton x:Name="TraceTab" Grid.Column="1" GroupName="DiagPanel" Margin="4,0,0,0"
                             Theme="{StaticResource DiagPanelTabTheme}"
                             IsChecked="{Binding ShowsPacketTrace}"
                             Content="{Binding PacketTraceTabTitle}" />
                <Button x:Name="CopyTraceButton" Grid.Column="3"
                        Theme="{StaticResource VelaTitleActionButtonTheme}"
                        Command="{Binding CopyPacketTraceCommand}"
                        IsVisible="{Binding ShowsPacketTrace}"
                        AutomationProperties.Name="{loc:Localize Diag_TraceCopy}"
                        ToolTip.Tip="{loc:Localize Diag_TraceCopy}">
                  <pc:LucideIcon Width="12" Height="12"
                                 Data="{StaticResource Icon.copy}"
                                 Foreground="{DynamicResource VelaTextMuted}" />
                </Button>
              </Grid>
            </Border>

            <!-- 协议轨迹:一行一个报文(时刻、方向、类型、长度、序号、通道),没有任何内容。 -->
            <DockPanel IsVisible="{Binding ShowsPacketTrace}" Margin="12,8,6,8">
              <TextBlock DockPanel.Dock="Top" Margin="0,0,6,6"
                         Text="{loc:Localize Diag_TraceHint}"
                         Foreground="{DynamicResource VelaTextMuted}"
                         FontSize="{DynamicResource VelaFontSize10}" TextWrapping="Wrap" />
              <TextBlock DockPanel.Dock="Bottom" Margin="0,6,6,0"
                         Text="{Binding PacketTraceDroppedText}"
                         IsVisible="{Binding PacketTraceDroppedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource VelaWarning}"
                         FontSize="{DynamicResource VelaFontSize10}" TextWrapping="Wrap" />
              <Panel>
                <TextBlock Text="{loc:Localize Diag_TraceEmpty}"
                           IsVisible="{Binding ShowsNoPacketTrace}"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource VelaTextMuted}"
                           FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap" />
                <ScrollViewer x:Name="TraceScroller" IsVisible="{Binding HasPacketTrace}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PacketTrace}" Grid.IsSharedSizeScope="True" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PacketTraceRowViewModel">
                        <StackPanel>
                          <TextBlock Text="{Binding HopHeader}" IsVisible="{Binding HasHopHeader}"
                                     Margin="0,4,0,2"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize10}" FontWeight="Medium"
                                     TextTrimming="CharacterEllipsis" />
                          <Grid Classes="trace-row">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" SharedSizeGroup="TraceTime" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="TraceDirection" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="TraceLength" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="TraceSequence" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="TraceChannel" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{DynamicResource VelaTextMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Direction}" Margin="8,0,0,0"
                                       Classes.sent="{Binding IsSent}" Classes="trace-direction" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource VelaTextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Length}" Margin="8,0,0,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource VelaTextSecondary}" />
                            <TextBlock Grid.Column="4" Text="{Binding Sequence}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource VelaTextMuted}" />
                            <TextBlock Grid.Column="5" Text="{Binding Channel}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource VelaTextMuted}" />
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </DockPanel>

            <StackPanel Spacing="10" Margin="14,12" IsVisible="{Binding ShowsResults}">

              <!-- 检测中占位 -->
              <TextBlock Text="{loc:Localize Diag_Running}"
                         IsVisible="{Binding IsBusy}"
                         Foreground="{DynamicResource VelaTextMuted}"
                         FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}" />

              <!-- 未发现问题 -->
              <Border Background="{DynamicResource VelaBgSurface}"
                      CornerRadius="6" Padding="12,10"
                      IsVisible="{Binding AllPassed}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <pc:LucideIcon Width="13" Height="13"
                                 Data="{StaticResource Icon.circle-check}"
                                 Foreground="{DynamicResource VelaStatusConnected}" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Localize Diag_AllPassed}"
                             Foreground="{DynamicResource VelaStatusConnected}"
                             FontSize="{DynamicResource VelaFontSize12}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- 问题卡片 (design issueCard) -->
              <Border Background="{DynamicResource VelaBgSurface}"
                      CornerRadius="6" Padding="12,10"
                      IsVisible="{Binding HasIssue}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <pc:LucideIcon Width="13" Height="13"
                                   Data="{StaticResource Icon.triangle-alert}"
                                   Foreground="{DynamicResource VelaWarning}" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource VelaWarning}"
                               FontSize="{DynamicResource VelaFontSize12}" FontWeight="SemiBold" VerticalAlignment="Center">
                      <Run Text="{loc:Localize Diag_IssueFound}" /><Run Text="{Binding IssueTitle}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Text="{Binding IssueDescription}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap" />
                  <!-- 算法协商失败、而对端有本版实现了只是没放开的算法:与终端标签失败覆盖层同一颗按钮,
                       确认后改配置并重新诊断一轮。描边 + 警示图标:它会降低这条连接的安全性。 -->
                  <Button x:Name="AllowAlgorithmsButton"
                          HorizontalAlignment="Left"
                          Margin="0,4,0,0"
                          IsVisible="{Binding HasAlgorithmRemedy}"
                          Command="{Binding AllowAlgorithmsCommand}"
                          Background="Transparent"
                          BorderBrush="{DynamicResource VelaBorderSecondary}"
                          BorderThickness="1"
                          CornerRadius="4" Padding="12,5"
                          ToolTip.Tip="{Binding AlgorithmRemedyTip}"
                          AutomationProperties.Name="{loc:Localize SshAlgoFix_ButtonRediagnose}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <pc:LucideIcon Width="12" Height="12"
                                     Data="{StaticResource Icon.triangle-alert}"
                                     Foreground="{DynamicResource VelaWarning}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize SshAlgoFix_ButtonRediagnose}"
                                 Foreground="{DynamicResource VelaTextSecondary}"
                                 FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding AlgorithmRemedyError}"
                             IsVisible="{Binding HasAlgorithmRemedyError}"
                             Foreground="{DynamicResource VelaError}"
                             FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- 修复建议 (design fixList) -->
              <ItemsControl ItemsSource="{Binding Suggestions}"
                            IsVisible="{Binding Suggestions.Count}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                      <pc:LucideIcon Width="11" Height="11"
                                     Data="{StaticResource Icon.info}"
                                     Foreground="{DynamicResource VelaAccent}"
                                     VerticalAlignment="Top" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding}"
                                 Foreground="{DynamicResource VelaTextPrimary}"
                                 FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap"
                                 MaxWidth="330" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
