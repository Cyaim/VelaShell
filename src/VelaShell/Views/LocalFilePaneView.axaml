<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:loc="using:VelaShell.Localization"
             xmlns:pc="using:VelaShell.Controls.Controls"
             xmlns:views="using:VelaShell.Views"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="400"
             x:Class="VelaShell.Views.LocalFilePaneView"
             x:DataType="vm:LocalFilePaneViewModel">
  <UserControl.Styles>
    <Style Selector="Button.toolbar-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <!-- 后退 / 前进没有历史可走时淡下去;执行中禁用时不铺 Fluent 的灰底(同远端栏)。 -->
    <Style Selector="Button.history-btn.unavailable">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.history-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 过滤框开关:与远端栏(FileBrowserView)同一种安静的图标开关,展开时图标染强调色。 -->
    <Style Selector="ToggleButton.pane-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    </Style>
    <Style Selector="ToggleButton.pane-toggle:checked">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
    <Style Selector="ToggleButton.pane-toggle /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.pane-toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ToggleButton.pane-toggle:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.pane-toggle:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Border.file-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Border.file-row.parent">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.crumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- 路径里的下划线是路径的一部分,不是访问键:默认 Button 模板的 ContentPresenter 开着
         RecognizesAccessKey,/app_old 会被渲染成 /appold
         (下划线吃掉、后一个字母加下划线)。面包屑不是菜单,不需要助记符。 -->
    <Style Selector="Button.crumb /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="False" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
    <!-- 列标题按钮:与远端栏(FileBrowserView)同一规格,点击按该列排序,再点翻转方向。 -->
    <Style Selector="Button.col-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.col-header:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource VelaBgSftpPanel}"
          BorderBrush="{DynamicResource VelaBorderPrimary}"
          BorderThickness="0,1,0,0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="36" Padding="14,0"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <!-- 面包屑与手动输入路径(铅笔 / 点面包屑后的空白 / Ctrl+L),与上传选择框共用一份,风格与远端 FileBrowserView 一致 -->
            <views:LocalPathBar x:Name="PathBar" VerticalAlignment="Center" />
            <ProgressBar Width="54" Height="3" Margin="12,0"
                         HorizontalAlignment="Left" IsIndeterminate="True"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsDirectoryLoading}" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ComboBox MinHeight="0" Height="22" Padding="6,0" FontSize="{DynamicResource VelaFontSize12}"
                      ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot, Mode=OneWay}"
                      SelectionChanged="OnRootSelectionChanged"
                      VerticalContentAlignment="Center" MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalRootEntry">
                  <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Tooltip}"
                             TextTrimming="CharacterEllipsis" FontSize="{DynamicResource VelaFontSize11}" Padding="2,1" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 当前目录过滤,与远端栏同一口径:只藏眼前的行,收起即清空,换目录清空文字。 -->
            <TextBox x:Name="FilterBox"
                     IsVisible="{Binding IsFilterOpen}"
                     Text="{Binding FilterText}"
                     PlaceholderText="{loc:Localize Sftp_FilterPlaceholder}"
                     AutomationProperties.Name="{loc:Localize Sftp_FilterPlaceholder}"
                     Width="140" Height="22" MinHeight="0" Padding="6,0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     FontFamily="{DynamicResource VelaUiMonoFont}"
                     FontSize="{DynamicResource VelaFontSize11}"
                     KeyDown="OnFilterBoxKeyDown" />
            <ToggleButton x:Name="FilterToggle" Classes="pane-toggle" Width="24" Height="24" Padding="0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          IsChecked="{Binding IsFilterOpen}"
                          Click="OnFilterToggleClick"
                          ToolTip.Tip="{loc:Localize Sftp_FilterToggle}"
                          AutomationProperties.Name="{loc:Localize Sftp_FilterToggle}">
              <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.list-filter}"
                             Foreground="{Binding $parent[ToggleButton].Foreground}" />
            </ToggleButton>
            <!-- 后退 / 前进(Alt+← / Alt+→),挨着上一级;提示语与读屏名与远程栏那两颗区分开。 -->
            <Button x:Name="LocalBackButton"
                    Classes="toolbar-btn history-btn" Classes.unavailable="{Binding !CanGoBack}"
                    Width="24" Height="24" Padding="0"
                    Command="{Binding GoBackCommand}"
                    ToolTip.Tip="{loc:Localize Sftp_BackLocalPane}"
                    AutomationProperties.Name="{loc:Localize Sftp_BackLocalPane}">
              <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.arrow-left}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
            <Button x:Name="LocalForwardButton"
                    Classes="toolbar-btn history-btn" Classes.unavailable="{Binding !CanGoForward}"
                    Width="24" Height="24" Padding="0"
                    Command="{Binding GoForwardCommand}"
                    ToolTip.Tip="{loc:Localize Sftp_ForwardLocalPane}"
                    AutomationProperties.Name="{loc:Localize Sftp_ForwardLocalPane}">
              <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.arrow-right}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
            <!-- 上一级与刷新同理:远程栏也有一颗,提示语与读屏名要分得出是哪一栏。 -->
            <Button x:Name="LocalGoUpButton"
                    Classes="toolbar-btn" Width="24" Height="24" Padding="0"
                    Command="{Binding GoUpCommand}"
                    ToolTip.Tip="{loc:Localize Sftp_GoUpLocalPane}"
                    AutomationProperties.Name="{loc:Localize Sftp_GoUpLocalPane}">
              <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.corner-left-up}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
            <!-- 双栏下两个刷新按钮必须可区分:提示语与 AutomationProperties.Name 都不能与远程栏那个重名,
                 否则无论鼠标悬停还是读屏都分不出刷的是哪一栏。 -->
            <Button x:Name="LocalRefreshButton"
                    Classes="toolbar-btn" Width="24" Height="24" Padding="0"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{loc:Localize Sftp_RefreshLocalPane}"
                    AutomationProperties.Name="{loc:Localize Sftp_RefreshLocalPane}">
              <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.refresh-cw}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- 右内边距 20 > 滚动条展开宽 16(VelaScrollBarSize):滚动条是覆盖式的,留 14 时
           展开的滑道会压住末列(修改时间)的末尾。表头与行必须同值,否则列对不齐。 -->
      <Border DockPanel.Dock="Top" Height="26" Padding="14,0,20,0"
              Background="{DynamicResource VelaBgContentHeader}"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <!-- 三列都可点击排序(规则同远端栏:目录始终在前,再点同一列翻转方向,换列从升序开始)。 -->
        <Grid ColumnDefinitions="*,90,130">
          <Button Classes="col-header" Command="{Binding SortCommand}" CommandParameter="name">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{loc:Localize FileName}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" LetterSpacing="1" Foreground="{DynamicResource VelaTextMuted}" />
              <TextBlock Text="{Binding NameSortGlyph}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="col-header" Command="{Binding SortCommand}" CommandParameter="size">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{loc:Localize Size}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" LetterSpacing="1" Foreground="{DynamicResource VelaTextMuted}" />
              <TextBlock Text="{Binding SizeSortGlyph}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="col-header" Command="{Binding SortCommand}" CommandParameter="modified">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{loc:Localize Modified}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" LetterSpacing="1" Foreground="{DynamicResource VelaTextMuted}" />
              <TextBlock Text="{Binding ModifiedSortGlyph}" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Top" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="{DynamicResource VelaBgActive}" Padding="8,4">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource VelaAccent}" FontSize="{DynamicResource VelaFontSize11}" />
      </Border>
      <!-- 列表外面套一层 Panel,是为了在它上面叠一个框选矩形(见 MarqueeOverlay)。 -->
      <Panel>
      <ListBox x:Name="FileList" ItemsSource="{Binding Entries}" SelectedItems="{Binding SelectedEntries}"
               SelectionMode="Multiple" Background="Transparent" BorderThickness="0"
               DoubleTapped="OnFileDoubleTapped">
        <ListBox.ContextMenu>
          <ContextMenu x:DataType="vm:LocalFilePaneViewModel">
            <MenuItem Header="{loc:Localize Refresh}" Command="{Binding RefreshCommand}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.refresh-cw}" Foreground="{DynamicResource VelaTextTertiary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Localize Sftp_Open}" Command="{Binding OpenItemCommand}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.file-text}" Foreground="{DynamicResource VelaAccent}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Localize Upload}" Command="{Binding UploadSelectedCommand}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.upload}" Foreground="{DynamicResource VelaAccent}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Localize Rename}" Command="{Binding RenameCommand}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.pencil}" Foreground="{DynamicResource VelaTextTertiary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Localize NewFolder}" Command="{Binding NewFolderCommand}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.folder-plus}" Foreground="{DynamicResource VelaTextTertiary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Localize Delete}" Command="{Binding DeleteSelectedCommand}" Foreground="{DynamicResource VelaError}">
              <MenuItem.Icon><pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.trash-2}" Foreground="{DynamicResource VelaError}" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LocalFileEntry">
            <Border Classes="file-row" Classes.parent="{Binding IsParentEntry}" Height="28" Padding="14,0,20,0"
                    BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1"
                    PointerPressed="OnFileRowPointerPressed">
              <Grid ColumnDefinitions="*,90,130">
                <Grid Classes="local-name-cell" ColumnDefinitions="Auto,*" MinWidth="0"
                      ClipToBounds="True" VerticalAlignment="Center">
                  <pc:LucideIcon Classes="dnd-surface" Width="13" Height="13" Margin="0,0,7,0"
                                 Data="{StaticResource Icon.folder}" Foreground="{DynamicResource VelaFileFolderIcon}"
                                 IsVisible="{Binding IsRegularDirectory}" />
                  <pc:LucideIcon Classes="dnd-surface" Width="13" Height="13" Margin="0,0,7,0"
                                 Data="{StaticResource Icon.file}" Foreground="{DynamicResource VelaTextTertiary}"
                                 IsVisible="{Binding IsRegularFile}" />
                  <pc:LucideIcon Classes="dnd-surface" Width="13" Height="13" Margin="0,0,7,0"
                                 Data="{StaticResource Icon.corner-left-up}" Foreground="{DynamicResource VelaTextTertiary}"
                                 IsVisible="{Binding IsParentEntry}" />
                  <TextBlock Classes="dnd-surface" Grid.Column="1" Text="{Binding DisplayName}" FontFamily="{DynamicResource VelaUiMonoFont}"
                             FontSize="{DynamicResource VelaFontSize11}" Foreground="{DynamicResource VelaTextSecondary}"
                             VerticalAlignment="Center" HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Classes="local-size-cell dnd-surface" Grid.Column="1" Text="{Binding FormattedSize}" FontFamily="{DynamicResource VelaUiMonoFont}"
                           FontSize="{DynamicResource VelaFontSize11}" Foreground="{DynamicResource VelaTextTertiary}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock Classes="dnd-surface" Grid.Column="2" Text="{Binding FormattedModifiedTime}" FontFamily="{DynamicResource VelaUiMonoFont}"
                           FontSize="{DynamicResource VelaFontSize11}" Foreground="{DynamicResource VelaTextTertiary}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

        <!-- 框选矩形。IsHitTestVisible=False:它盖在列表上,不能把指针事件吃掉。 -->
        <Border Name="MarqueeOverlay" IsVisible="False" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource VelaAccent}" Opacity="0.18"
                BorderBrush="{DynamicResource VelaAccent}" BorderThickness="1"
                CornerRadius="1" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
