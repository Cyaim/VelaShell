<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:conv="using:VelaShell.Converters"
             xmlns:models="using:VelaShell.Core.Models"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.SecurityAuditPage"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetSecurity_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetSecurity_Subtitle}" />
    </StackPanel>

    <!-- 会话录制(设计 NceE6;设置审计 R-11 已实现恢复展示)。
         输入脱敏(R-12)不再需要:录制仅捕获终端输出流,密码输入本就无回显。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetSecurity_SectionRecording}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AutoRecord}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_AutoRecordDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.RecordProductionSessions}" VerticalAlignment="Center" />
    </Grid>
    <!-- 录制与会话日志落盘前遮盖口令、令牌、私钥(默认开);屏幕显示不受影响。 -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_MaskCaptures}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_MaskCapturesDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.MaskSecretsInCaptures}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_RecordingCenter}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_RecordingCenterDesc}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="dlg-outline" Content="{loc:Localize SetSecurity_OpenPlayer}"
              Click="OpenRecordingPlayer_Click" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 审计日志:连接成败、指纹裁决与外部拉起一直在写 audit_log,这里是看它的地方与它的保留期。
         保留天数同时管连接历史(conn_history),两张表只在启动时按它清理。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetSecurity_SectionAuditLog}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AuditLogViewer}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_AuditLogViewerDesc}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="dlg-outline" Content="{loc:Localize SetSecurity_OpenAuditLog}"
              Click="OpenAuditLog_Click" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AuditLogRetention}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_AuditLogRetentionDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="90" Value="{Binding Security.AuditLogRetentionDays}"
                     Minimum="1" Maximum="3650" Increment="30" FormatString="0" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 主机信任策略 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetSecurity_SectionTrust}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_ConfirmFirstFingerprint}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_ConfirmFirstFingerprintDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.ConfirmFirstFingerprint}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_BlockOnChange}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_BlockOnChangeDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.BlockOnFingerprintChange}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 已信任主机(known_hosts):查看/删除已记录的主机指纹。
         删除即时生效,下次连接该主机将重新执行首次指纹确认流程。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetSecurity_SectionKnownHosts}" />
    <TextBlock Classes="row-desc"
               Text="{loc:Localize SetSecurity_KnownHostsDesc}" />
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasKnownHosts}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_MaskAddresses}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_MaskAddressesDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding MaskKnownHostAddresses}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_NoKnownHosts}"
               IsVisible="{Binding !HasKnownHosts}" />
    <!-- 列表限高约 6 行(单行 ≈50px:12,8 内边距 + 两行文本 + 1px 分隔线),其余在框内滚动:
         上百台已信任主机时不会把整页撑长到滚不到底部的设置项。 -->
    <Border Classes="table" IsVisible="{Binding HasKnownHosts}">
      <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding KnownHosts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:KnownHost">
              <!-- 右内边距 20 > 滚动条展开宽 16(VelaScrollBarSize):滚动条是覆盖式的,
                   悬停展开时会盖住行的右边缘,不留出这段就压到“删除”按钮上。
                   留白走内边距而非外边距,底部分隔线仍铺满整行宽度。 -->
              <Border Padding="12,8,20,8"
                      BorderBrush="{DynamicResource VelaBorderPrimary}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- 地址脱敏:掩码为固定长度,不暴露真实地址的位数;
                           按指纹区分各条目(指纹是服务器公钥哈希,非敏感信息)。 -->
                      <TextBlock FontSize="{DynamicResource VelaFontSize12}" FontWeight="Medium"
                                 Foreground="{DynamicResource VelaTextPrimary}"
                                 IsVisible="{Binding !$parent[ItemsControl].((vm:SettingsViewModel)DataContext).MaskKnownHostAddresses}">
                        <Run Text="{Binding Host, Converter={x:Static conv:HostBracketConverter.Instance}}" /><Run Text=":" /><Run Text="{Binding Port}" />
                      </TextBlock>
                      <TextBlock FontSize="{DynamicResource VelaFontSize12}" FontWeight="Medium"
                                 Foreground="{DynamicResource VelaTextPrimary}"
                                 Text="••••••••••:•••"
                                 IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MaskKnownHostAddresses}" />
                      <TextBlock FontSize="{DynamicResource VelaFontSize10}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VelaTextMuted}"
                                 Text="{Binding KeyType}" />
                    </StackPanel>
                    <TextBlock FontSize="{DynamicResource VelaFontSize10}"
                               FontFamily="{DynamicResource VelaUiMonoFont}"
                               Foreground="{DynamicResource VelaTextMuted}"
                               TextWrapping="Wrap"
                               Text="{Binding Fingerprint}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="dlg-danger" Content="{loc:Localize Delete}"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveKnownHostCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 与 OpenSSH 互通:known_hosts 的导入 / 导出。导入的普通行进上面的列表,
         @cert-authority / @revoked 进下面的「受信主机 CA」;导出写 OpenSSH 格式,可选散列主机名。 -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize KnownHosts_InteropLabel}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize KnownHosts_InteropDesc}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="dlg-outline" Content="{loc:Localize KnownHosts_Import}"
                IsEnabled="{Binding !HostTrust.IsBusy}"
                Click="ImportKnownHosts_Click" />
        <Button Classes="dlg-outline" Content="{loc:Localize KnownHosts_Export}"
                IsEnabled="{Binding !HostTrust.IsBusy}"
                Click="ExportKnownHosts_Click" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize KnownHosts_HashOnExport}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize KnownHosts_HashOnExportDesc}" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding HostTrust.HashHostNamesOnExport}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Classes="row-desc" Text="{Binding HostTrust.StatusText}" TextWrapping="Wrap"
               IsVisible="{Binding HostTrust.HasStatus}" />

    <Border Classes="sep" />

    <!-- 受信主机 CA(OpenSSH @cert-authority)与吊销记录(@revoked):按主机名模式生效。
         CA 签发的主机证书在主机名对上模式时直接受信;这类主机出示没有证书担保的钥一律拒绝,不退回首次确认
         (velashell-docs/zh/ssh/spec/03 §5.5)。改动当场生效,不随「保存」走。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize HostCa_Section}" />
    <TextBlock Classes="row-desc" Text="{loc:Localize HostCa_SectionDesc}" TextWrapping="Wrap" />
    <TextBlock Classes="row-desc" Text="{loc:Localize HostCa_Empty}"
               IsVisible="{Binding !HostTrust.HasMarkers}" />
    <Border Classes="table" IsVisible="{Binding HostTrust.HasMarkers}">
      <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding HostTrust.Markers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KnownHostMarkerRow">
              <!-- 右内边距 20 同上:给覆盖式滚动条让出位置。 -->
              <Border Padding="12,8,20,8"
                      BorderBrush="{DynamicResource VelaBorderPrimary}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontSize="{DynamicResource VelaFontSize10}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VelaAccentText}"
                                 Text="{Binding KindText}" IsVisible="{Binding !IsRevoked}" />
                      <TextBlock FontSize="{DynamicResource VelaFontSize10}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VelaError}"
                                 Text="{Binding KindText}" IsVisible="{Binding IsRevoked}" />
                      <TextBlock FontSize="{DynamicResource VelaFontSize12}" FontWeight="Medium"
                                 Foreground="{DynamicResource VelaTextPrimary}"
                                 FontFamily="{DynamicResource VelaUiMonoFont}"
                                 TextWrapping="Wrap"
                                 Text="{Binding Patterns}" />
                      <TextBlock FontSize="{DynamicResource VelaFontSize10}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource VelaTextMuted}"
                                 Text="{Binding KeyType}" />
                    </StackPanel>
                    <TextBlock FontSize="{DynamicResource VelaFontSize10}"
                               FontFamily="{DynamicResource VelaUiMonoFont}"
                               Foreground="{DynamicResource VelaTextMuted}"
                               TextWrapping="Wrap"
                               Text="{Binding Fingerprint}" />
                    <TextBlock FontSize="{DynamicResource VelaFontSize10}"
                               Foreground="{DynamicResource VelaTextTertiary}"
                               TextWrapping="Wrap"
                               Text="{Binding Comment}" IsVisible="{Binding HasComment}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="dlg-danger" Content="{loc:Localize Delete}"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).HostTrust.RemoveMarkerCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <!-- 添加一个受信 CA:模式 + CA 公钥行(或从 known_hosts 整行复制来的 @cert-authority / @revoked 行)。 -->
    <StackPanel Spacing="6" IsEnabled="{Binding HostTrust.IsAvailable}">
      <TextBlock Classes="row-label" Text="{loc:Localize HostCa_AddTitle}" />
      <TextBox Text="{Binding HostTrust.NewPatterns}"
               PlaceholderText="*.corp.example,!legacy.corp.example" />
      <TextBlock Classes="row-desc" Text="{loc:Localize HostCa_PatternsDesc}" TextWrapping="Wrap" />
      <TextBox Text="{Binding HostTrust.NewPublicKey}" TextWrapping="Wrap"
               FontFamily="{DynamicResource VelaUiMonoFont}"
               PlaceholderText="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA… host-ca@corp.example" />
      <TextBlock Classes="row-desc" Text="{loc:Localize HostCa_KeyDesc}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding HostTrust.NewComment}" PlaceholderText="{loc:Localize HostCa_CommentPlaceholder}" />
        <Button Grid.Column="1" Classes="dlg-outline" Margin="8,0,0,0" Content="{loc:Localize HostCa_Add}"
                Command="{Binding HostTrust.AddMarkerCommand}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="row-desc" Foreground="{DynamicResource VelaError}" TextWrapping="Wrap"
                 Text="{Binding HostTrust.AddError}" IsVisible="{Binding HostTrust.HasAddError}" />
    </StackPanel>

    <Border Classes="sep" />

    <!-- 外部登录(Xshell 兼容):堡垒机/SSO 网页按 Xshell 的调用约定拉起本应用去登录服务器。
         凭据与目标都来自外部,因此默认要过一道确认弹窗;协议关联默认不开(只写 HKCU)。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetSecurity_SectionExternalLaunch}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AllowExternalLaunch}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_AllowExternalLaunchDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.AllowExternalLaunch}" VerticalAlignment="Center" />
    </Grid>
    <!-- 从属设置:允许外部拉起时才有意义(设置审计 §10)。 -->
    <StackPanel Spacing="14" IsVisible="{Binding Security.AllowExternalLaunch}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_ConfirmExternalLaunch}" />
          <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_ConfirmExternalLaunchDesc}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.ConfirmExternalLaunch}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_RegisterProtocols}" />
          <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_RegisterProtocolsDesc}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.RegisterUrlProtocols}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTrustedLaunchTargets}">
        <StackPanel Spacing="2">
          <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_TrustedLaunchTargets}" />
          <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_TrustedLaunchTargetsDesc}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="row-desc" Text="{Binding TrustedLaunchTargetCount}" VerticalAlignment="Center" />
          <Button Classes="dlg-outline"
                  Content="{loc:Localize SetSecurity_ClearTrustedLaunchTargets}"
                  Command="{Binding ClearTrustedLaunchTargetsCommand}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Classes="sep" />

    <!-- 告警通道 -->
    <TextBlock Text="{loc:Localize SetSecurity_SectionAlerts}"
               Foreground="{DynamicResource VelaInfo}" FontSize="{DynamicResource VelaFontSize12}" FontWeight="SemiBold" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AlertInApp}" VerticalAlignment="Center" />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.AlertInApp}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetSecurity_AlertSound}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_AlertSoundDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.AlertSound}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="Webhook" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetSecurity_WebhookDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Security.AlertWebhook}" VerticalAlignment="Center" />
    </Grid>
    <!-- 从属设置:开启 Webhook 后显示(设置审计 §10)。 -->
    <StackPanel Spacing="5" IsVisible="{Binding Security.AlertWebhook}">
      <TextBlock Classes="row-label" Text="Webhook URL" />
      <TextBox Text="{Binding Security.WebhookUrl}" PlaceholderText="https://example.com/hooks/velashell" />
      <TextBlock Classes="row-desc"
                 Text="{loc:Localize SetSecurity_WebhookPayloadDesc}" />
    </StackPanel>
  </StackPanel>
</UserControl>
