<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:loc="using:VelaShell.Localization"
        xmlns:pc="using:VelaShell.Controls.Controls"
        x:Class="VelaShell.Views.SshConnectionInfoWindow"
        x:DataType="vm:SshConnectionInfoViewModel"
        Title="{loc:Localize SshInfo_Title}"
        Width="760" Height="680"
        MinWidth="560" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

  <!-- SSH 连接信息(会话标签右键 → 连接信息):只读面板,按块摆对端、协商结果、认证、计时、流量与重协商、通道、经过的跳板。
       数据全是 SSH 库的只读属性,打开与刷新都不往线上发东西。外框、标题栏与右下角缩放手柄照审计日志窗口;
       窗口级动作(复制为文本、刷新)放标题栏的动作图标组(DESIGN.md §4.2)。 -->

  <Window.Styles>
    <!-- 窗口控制键:27×27、无圆角,规格同主窗口(与回放中心、资源监视、审计日志同一套本地样式)。 -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaDangerHover}" />
    </Style>
    <Style Selector="Border.info-card">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.block-title">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 值一律等宽、可划选:算法名、指纹、会话 ID 都是要原样拿走的东西。 -->
    <Style Selector="SelectableTextBlock.field-value">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 跳板那一行下面的算法摘要:比地址淡一级。 -->
    <Style Selector="SelectableTextBlock.hop-summary">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.hop-down">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*">

      <!-- 标题栏(28,可拖动,双击空白处最大化 / 还原):图标 + 标题 | 会话标识、复制、刷新 | 最大化、关闭。 -->
      <Border Grid.Row="0" Padding="20,0,0,0"
              Classes="window-titlebar"
              Background="Transparent"
              PointerPressed="Header_PointerPressed"
              DoubleTapped="Header_DoubleTapped">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <DockPanel>
            <Panel Classes="traffic-light-spacer" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <pc:LucideIcon Width="15" Height="15" Data="{StaticResource Icon.info}"
                             Foreground="{DynamicResource VelaAccent}" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Localize SshInfo_Title}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource VelaTextPrimary}"
                         FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center" Margin="12,0,10,0">
            <!-- 会话标识:连着时绿点,没连着时红点;名字长了截断,悬停看全名。 -->
            <Border Background="{DynamicResource VelaBgInput}"
                    BorderBrush="{DynamicResource VelaBorderSecondary}" BorderThickness="1"
                    CornerRadius="4" Padding="7,2" Margin="0,0,4,0" VerticalAlignment="Center" MaxWidth="240"
                    IsVisible="{Binding SessionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    ToolTip.Tip="{Binding SessionName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource VelaStatusConnected}" IsVisible="{Binding HasDetails}" />
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource VelaStatusDisconnected}" IsVisible="{Binding IsUnavailable}" />
                <TextBlock Text="{Binding SessionName}" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource VelaUiMonoFont}"
                           FontSize="{DynamicResource VelaFontSize10}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
              </StackPanel>
            </Border>
            <!-- 复制为文本:与面板上摆的是同一份;复制完图标短暂换成强调色的勾。 -->
            <Button x:Name="CopyButton" Theme="{StaticResource VelaTitleActionButtonTheme}"
                    Command="{Binding CopyCommand}"
                    AutomationProperties.Name="{loc:Localize SshInfo_Copy}"
                    ToolTip.Tip="{loc:Localize SshInfo_Copy}">
              <Panel>
                <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.copy}"
                               Foreground="{DynamicResource VelaTextMuted}" IsVisible="{Binding !Copied}" />
                <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.circle-check}"
                               Foreground="{DynamicResource VelaAccent}" IsVisible="{Binding Copied}" />
              </Panel>
            </Button>
            <Button x:Name="RefreshButton" Theme="{StaticResource VelaTitleActionButtonTheme}"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{loc:Localize SshInfo_Refresh}"
                    ToolTip.Tip="{loc:Localize SshInfo_Refresh}">
              <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.refresh-cw}"
                             Foreground="{DynamicResource VelaTextMuted}" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Classes="caption window-caption" Click="Maximize_Click"
                    ToolTip.Tip="{loc:Localize Recorder_MaximizeTip}">
              <pc:LucideIcon Width="10" Height="10" Data="{StaticResource Icon.square}"
                             Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Classes="caption caption-close window-caption" Click="Close_Click">
              <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.x}"
                             Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 副标题:目标 + 取快照的时刻。同样可拖动。 -->
      <Border Grid.Row="1" Padding="20,6"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              Background="Transparent"
              PointerPressed="Header_PointerPressed">
        <TextBlock Text="{Binding Subtitle}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource VelaTextMuted}"
                   FontFamily="{DynamicResource VelaUiMonoFont}"
                   FontSize="{DynamicResource VelaFontSize10}" TextTrimming="CharacterEllipsis" />
      </Border>

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,20" Spacing="12">

          <!-- 没连着:如实说,不留一片空白。 -->
          <Border Classes="info-card" IsVisible="{Binding IsUnavailable}">
            <TextBlock Text="{loc:Localize SshInfo_Unavailable}" TextWrapping="Wrap"
                       Foreground="{DynamicResource VelaTextMuted}"
                       FontSize="{DynamicResource VelaFontSize12}" />
          </Border>

          <!-- 键值块:对端 / 协商结果 / 认证 / 计时 / 流量与重协商。 -->
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConnectionInfoSection">
                <Border Classes="info-card">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="block-title" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionInfoField">
                          <Grid ColumnDefinitions="190,*">
                            <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0,0,12,0" />
                            <SelectableTextBlock Grid.Column="1" Classes="field-value" Text="{Binding Value}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 通道:类型、状态、开了多久、收发字节。 -->
          <Border Classes="info-card" IsVisible="{Binding HasDetails}">
            <StackPanel Spacing="4">
              <TextBlock Classes="block-title" Text="{Binding ChannelsTitle}" />
              <Grid ColumnDefinitions="40,*,110,80,90,90" Margin="0,0,0,2">
                <TextBlock Grid.Column="0" Classes="header" Text="#" />
                <TextBlock Grid.Column="1" Classes="header" Text="{loc:Localize SshInfo_ColType}" />
                <TextBlock Grid.Column="2" Classes="header" Text="{loc:Localize SshInfo_ColState}" />
                <TextBlock Grid.Column="3" Classes="header" Text="{loc:Localize SshInfo_ColAge}" />
                <TextBlock Grid.Column="4" Classes="header" Text="{loc:Localize SshInfo_Sent}" />
                <TextBlock Grid.Column="5" Classes="header" Text="{loc:Localize SshInfo_Received}" />
              </Grid>
              <TextBlock Text="{loc:Localize SshInfo_NoChannels}" IsVisible="{Binding HasNoChannels}"
                         Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" />
              <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionInfoChannelRow">
                    <Grid ColumnDefinitions="40,*,110,80,90,90" Height="22">
                      <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Id}" />
                      <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Type}" ToolTip.Tip="{Binding Type}" />
                      <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Phase}" />
                      <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Age}" />
                      <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Sent}" />
                      <TextBlock Grid.Column="5" Classes="cell" Text="{Binding Received}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 经过的代理与跳板(从近到远):每跳一行地址,下面一行算法摘要。直连时整块不显示。 -->
          <Border Classes="info-card" IsVisible="{Binding HasRoute}">
            <StackPanel Spacing="6">
              <TextBlock Classes="block-title" Text="{loc:Localize SshInfo_SecRoute}" />
              <ItemsControl ItemsSource="{Binding Route}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionInfoHopRow">
                    <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" Classes="cell" VerticalAlignment="Top" Text="{Binding Index}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <SelectableTextBlock Classes="field-value" Text="{Binding Target}" />
                        <TextBlock Classes="hop-down" Text="{loc:Localize SshInfo_HopDown}" IsVisible="{Binding IsDown}" />
                      </StackPanel>
                      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="field-value hop-summary"
                                           Text="{Binding Summary}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 右下角缩放手柄(同审计日志;系统自带边缘缩放时与最大化时由 WindowChrome 隐去)。 -->
      <Border x:Name="ResizeGrip" Grid.Row="2" Width="20" Height="20" ZIndex="10"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner"
              PointerPressed="ResizeGrip_PointerPressed"
              ToolTip.Tip="{loc:Localize Recorder_ResizeTip}">
        <Path Data="M14,4 L4,14 M14,9 L9,14"
              Stroke="{DynamicResource VelaTextMuted}" StrokeThickness="1.5"
              Margin="0,0,3,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
      </Border>
    </Grid>
  </Border>
</Window>
