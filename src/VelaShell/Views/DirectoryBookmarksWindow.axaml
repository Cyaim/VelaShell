<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:loc="using:VelaShell.Localization"
        xmlns:pc="using:VelaShell.Controls.Controls"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        x:Class="VelaShell.Views.DirectoryBookmarksWindow"
        x:DataType="vm:SftpDocumentViewModel"
        Title="{loc:Localize Bookmark_Manage}"
        Width="760" Height="520"
        MinWidth="560" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.toolbar-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
    </Style>
    <Style Selector="TextBlock.path">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.name">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border Classes="window-card" ClipToBounds="True"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="window-titlebar window-card-top"
                Height="28" Padding="12,0"
                Background="{DynamicResource VelaBgSurface}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.star}"
                             Foreground="{DynamicResource VelaAccent}" />
              <TextBlock Text="{Binding $parent[Window].Title}"
                         Foreground="{DynamicResource VelaTextPrimary}"
                         FontSize="{DynamicResource VelaFontSize12}" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="toolbar-btn window-caption"
                    Width="27" Height="27" Padding="0" Click="OnCloseClick"
                    ToolTip.Tip="{loc:Localize Cancel}"
                    AutomationProperties.Name="{loc:Localize Cancel}">
              <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.x}"
                             Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="48" Padding="14,0"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- 收藏操作的错误在这里也要看得见:从本窗口发起的新增 / 编辑 / 删除失败了,
                 只写在文档工具条上的话,文档不在前台时用户根本看不到。 -->
            <TextBlock Text="{loc:Localize Bookmark_ManageHint}"
                       IsVisible="{Binding BookmarkErrorMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                       Foreground="{DynamicResource VelaTextMuted}"
                       FontSize="{DynamicResource VelaFontSize10}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ErrorText" Text="{Binding BookmarkErrorMessage}"
                       IsVisible="{Binding BookmarkErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource VelaError}"
                       FontSize="{DynamicResource VelaFontSize10}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding BookmarkErrorMessage}" />
            <Button Grid.Column="1" Classes="action"
                    Click="OnAddClick"
                    AutomationProperties.Name="{loc:Localize Bookmark_Add}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.star}"
                               Foreground="{DynamicResource VelaAccent}" />
                <TextBlock Text="{loc:Localize Bookmark_Add}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="14,10"
                  Background="{DynamicResource VelaBgInput}"
                  BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
            <TextBlock Text="{loc:Localize Bookmark_ManageHint}"
                       Foreground="{DynamicResource VelaTextSecondary}"
                       FontSize="{DynamicResource VelaFontSize11}" TextWrapping="Wrap" />
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="BookmarkList" ItemsSource="{Binding Bookmarks}"
                     Background="Transparent" BorderThickness="0"
                     DoubleTapped="OnBookmarkDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DirectoryBookmarkViewModel">
                  <Border Padding="14,8" BorderBrush="{DynamicResource VelaBorderPrimary}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <StackPanel MinWidth="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="name" Text="{Binding Name}" />
                        <TextBlock Classes="path" Text="{Binding LocalPath}" />
                        <TextBlock Classes="path" Text="{Binding RemotePath}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="action" Click="OnApplyClick"
                              ToolTip.Tip="{loc:Localize Bookmark_Apply}"
                              AutomationProperties.Name="{loc:Localize Bookmark_Apply}">
                        <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.play}"
                                       Foreground="{DynamicResource VelaAccent}" />
                      </Button>
                      <Button Grid.Column="2" Classes="action" Click="OnEditClick"
                              ToolTip.Tip="{loc:Localize Edit}"
                              AutomationProperties.Name="{loc:Localize Edit}">
                        <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.pencil}"
                                       Foreground="{DynamicResource VelaTextTertiary}" />
                      </Button>
                      <Button Grid.Column="3" Classes="action danger" Click="OnDeleteClick"
                              ToolTip.Tip="{loc:Localize Delete}"
                              AutomationProperties.Name="{loc:Localize Delete}">
                        <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.trash-2}"
                                       Foreground="{DynamicResource VelaError}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="{loc:Localize Bookmark_NoItems}"
                       IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource VelaTextMuted}"
                       FontSize="{DynamicResource VelaFontSize12}" />
          </Grid>
        </Grid>
      </DockPanel>
    </Border>
  </Panel>
</Window>
